# Pooled connection for the app (Neon pooler host). Must target the same DB as DIRECT_URL.
DATABASE_URL=
# Direct connection for Prisma migrations (Neon direct host). Must target the same DB as DATABASE_URL.
DIRECT_URL=
# HS256 JWT signing secret, >= 32 chars.
AUTH_SECRET=
# Must equal Asia/Kolkata — enforced by payment.service.ts.
BOOKING_TIME_ZONE=Asia/Kolkata
# Active Interviewer.id used for all new reservations.
DEFAULT_INTERVIEWER_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Shared secret for POST /api/admin/expiry-sweep (header x-expiry-sweep-secret).
EXPIRY_SWEEP_SECRET=
